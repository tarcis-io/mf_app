# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real secrets.

# Secret used by Auth.js to encrypt the session cookie / JWT.
# Generate one with:  npx auth secret
AUTH_SECRET=

# Google OAuth 2.0 credentials from the Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID, type "Web application").
#
# Authorized redirect URI for local development:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
