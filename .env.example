# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real secrets.

# Secret used by Auth.js to encrypt the session cookie / JWT.
# Generate one with:  npx auth secret
AUTH_SECRET=

# Google OAuth 2.0 credentials from the Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID, type "Web application").
#
# Authorized redirect URI for local development:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public URL of the deployment, used by Auth.js to build OAuth callback URLs
# when running behind a proxy (e.g. Cloud Run). Not needed for local dev
# (localhost is inferred). REQUIRED in production — the app fails to start
# without it when NODE_ENV=production. Set it to the deployed origin, e.g.
#   AUTH_URL=https://mf-app-xxxxx.a.run.app
# AUTH_URL=

# Required on Cloud Run (and most reverse-proxy deployments): tells Auth.js to
# trust the proxy's forwarded Host header. Without it, sign-in fails with an
# "UntrustedHost" error. Not needed for local dev.
# See DEPLOYMENT.md for the full production env contract and OAuth setup.
# AUTH_TRUST_HOST=true

# Base URL of mf_service, the API this app calls server-side for batch data
# (e.g. the home page's Batches card). REQUIRED in production — the app fails to
# start without it when NODE_ENV=production. Optional for local dev: if unset,
# the Batches card just shows its error state and the rest of the app works.
# Point it at a running mf_service, e.g.
#   MF_SERVICE_URL=http://localhost:8000
# MF_SERVICE_URL=
